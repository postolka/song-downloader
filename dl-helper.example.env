## Staging
# Removes given patterns fromm the filename
reRemove=(
	'\s*www\..*$'
	'\s*(Original Mix)'
)

# Unifies "ft." and "feat."
reFixFeat=(
	'\((ft|feat)\.?\s?(.*)\)$'
)

# Replaces "and" by "&" character
fixAnd=(
#	'Pola & Bryson'
#	'Camo & Krooked'
)


